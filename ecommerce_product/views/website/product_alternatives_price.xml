<odoo>
    <!--
        Odoo 19: oculta el precio en los snippets dinámicos de productos
        (productos alternativos, vistos recientemente...) a los usuarios no identificados.

        La versión anterior redefinía entera la plantilla de website_sale con el mismo
        id, lo que la sobrescribía con código de una versión anterior. Ahora se hereda.
    -->
    <template id="price_dynamic_filter_template_product_product_custom"
              inherit_id="website_sale.price_dynamic_filter_template_product_product"
              name="Dynamic Product Filter Price: hide for public users">
        <xpath expr="//t[@t-if]" position="attributes">
            <attribute name="t-if">not data.get('prevent_zero_price_sale') and not data.get('is_sample') and not user_id._is_public()</attribute>
        </xpath>
    </template>
</odoo>
