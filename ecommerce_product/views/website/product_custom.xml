<odoo>
    <!--
        Odoo 19: personalización de la ficha de producto.

        La versión anterior (Odoo 17) tenía xpaths que ya no existen en Odoo 19.
        Reparto actual:
        - Descripción ecommerce bajo el título: ya la muestra Odoo 19 (product_title).
        - Bloque de información técnica, propiedades, certificaciones, iconos de
          cuidado y "Made in": product_info_custom.xml.
        - En este archivo: botón de carrito, productos del pack y atributos simples.
    -->

    <!-- Los productos de tipo "Swatches" no tienen botón "Add to cart" en su ficha:
         se añaden al carrito a través del Open Pack. -->
    <template id="product_cta_custom" inherit_id="website_sale.cta_wrapper" name="Pyratex: hide add to cart for swatches">
        <xpath expr="//a[@id='add_to_cart']" position="attributes">
            <attribute name="t-if">product.producttype_id.name != 'Swatches'</attribute>
        </xpath>
    </template>

    <template id="product_properties_view_custom" inherit_id="website_sale.product" name="Pyratex: product page">
        <!-- Muestra los productos que contiene un pack cerrado -->
        <xpath expr="//section[@id='product_detail']" position="after">
            <div t-if="product.sudo().pack_line_ids" class="container mb-5">
                <div class="d-flex overflow-auto">
                    <div class="row justify-content-start flex-nowrap">
                        <t t-foreach="product.sudo().pack_line_ids" t-as="pack">
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                <div class="text-center">
                                    <img t-if="pack.product_id.image_1920" class="img-fluid"
                                         t-att-src="image_data_uri(pack.product_id.image_1920)"
                                         t-att-alt="pack.product_id.name"/>
                                    <img t-else="" class="img-fluid"
                                         src="/ecommerce_product/static/img/placeholder.png"
                                         t-att-alt="pack.product_id.name"/>
                                    <p class="mt-2" t-field="pack.product_id.name"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Cuando hay un único valor de atributo no se muestra el bloque de atributos simples -->
        <xpath expr="//div[@id='product_attributes_simple']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
