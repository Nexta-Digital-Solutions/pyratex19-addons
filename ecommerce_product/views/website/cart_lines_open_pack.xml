<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 19: el selector de cantidad del carrito está en su propia plantilla
        (website_sale.cart_lines_quantity). Para las muestras (Swatches) y el
        "Open Pack" no se permite cambiar la cantidad: se muestra la cantidad
        en modo lectura, que es la rama t-else de la plantilla estándar.
    -->
    <template id="cart_lines_open_pack" inherit_id="website_sale.cart_lines_quantity" name="Open Pack Cart">
        <xpath expr="//t[@t-if='should_show_quantity_selector and line._is_sellable()']" position="attributes">
            <attribute name="t-if">should_show_quantity_selector and line._is_sellable() and line.product_id.producttype_id.name != 'Swatches' and line.product_id.name != 'Open Pack'</attribute>
        </xpath>
    </template>
</odoo>
