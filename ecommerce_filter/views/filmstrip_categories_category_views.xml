<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Oculta la tira de categorías (filmstrip) de la tienda.
         Odoo 19: el elemento <t name="Categories Filmstrip"> ya no existe; se oculta
         el contenedor #o_wsale_categories_filmstrip. -->
    <template id="filmstrip_categories_category" inherit_id="website_sale.filmstrip_categories" name="Categories">
        <xpath expr="//div[@id='o_wsale_categories_filmstrip']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
